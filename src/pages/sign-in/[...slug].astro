---
import Layout from '../../layouts/Layout.astro';
import { SignIn } from '@clerk/astro/components';
---

<Layout title="Sign In — The Weekend Read" description="Sign in to your account at The Weekend Read.">
  <div class="min-h-[calc(100vh-8rem)] flex items-center justify-center p-6">
    <div class="w-full max-w-md flex flex-col items-center">
      <div class="mb-8 text-center">
        <h1 class="font-sans font-semibold text-2xl tracking-tight text-primary">Welcome Back</h1>
        <p class="text-sm text-body mt-1">Sign in to manage your minimalist reading list.</p>
      </div>
      
      <!-- Clerk Sign In Component -->
      <SignIn routing="path" path="/sign-in" signUpUrl="/sign-up" redirectUrl="/dashboard" />
    </div>
  </div>
</Layout>
