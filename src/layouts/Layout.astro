---
import '../styles/global.css';
import { Show, UserButton } from '@clerk/astro/components';
import { BookOpen } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
}

const { 
  title = "The Weekend Read — A Minimalist Link-Saver", 
  description = "A dead-simple link-saver that prevents digital hoarding. Save links during the week, read exactly 3 randomly chosen links every Friday.",
  keywords = "Reading list, reading list, the reading list, chrome reading list, reading list chrome, reading list iphone, reading list safari, reading list app, weekend list, best reading list app, my reading list app, online reading list app, read later, read later app",
  ogImage = "/web-app-manifest-512x512.png",
  ogType = "website"
} = Astro.props;

const { pathname } = Astro.url;
const isDashboard = pathname.startsWith('/dashboard');
const canonicalUrl = new URL(pathname, "https://readinglistapp.com").href;
const ogUrl = new URL(pathname, "https://readinglistapp.com").href;
---

<!doctype html>
<html lang="en" class="h-full dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Weekend" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Best Practices -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, ogUrl).href} />
    <meta property="og:site_name" content="The Weekend Read" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={ogUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, ogUrl).href} />
    
    <!-- Inline styles for fonts to resolve flash of unstyled text -->
    <style>
      /* Prevent FOUC and set Vercel scroll behaviors */
      html {
        scroll-behavior: smooth;
      }
    </style>
    <!-- Dark/Light Mode Script (inline in head to avoid flicker) -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'dark'; // Default fallback theme
      };
      
      const theme = getTheme();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="h-full flex flex-col bg-canvas-soft text-ink font-sans antialiased selection:bg-primary selection:text-on-primary">
    
    <!-- Premium Glassmorphic Nav Bar -->
    <header class="sticky top-0 z-50 w-full bg-canvas/70 backdrop-blur-xl border-b border-hairline/50 transition-all duration-300">
      
      <div class="max-w-7xl mx-auto py-4 sm:py-6 px-4 sm:px-10 flex items-center justify-between">
        
        <!-- Logo and Brand -->
        <a href="/" class="flex items-center gap-2 hover:opacity-90 transition-opacity z-50" id="nav-home-link">
          <BookOpen class="w-5 h-5 text-primary" stroke-width={2.5} />
          <span class="font-sans font-semibold text-base sm:text-lg tracking-tight text-primary">
            <span class="hidden sm:inline">The Weekend Read</span>
            <span class="inline sm:hidden max-[380px]:hidden">Weekend Read</span>
          </span>
        </a>
        
        <!-- Navigation Links & Authentication -->
        <nav class="flex items-center gap-3 sm:gap-4 z-50" aria-label="Main Navigation">
          <!-- Desktop text links -->
          <div class="hidden md:flex items-center gap-3 sm:gap-4">
            <a 
              href="/about" 
              class={`text-sm font-medium transition-all duration-200 px-3 py-1.5 rounded-full ${
                pathname === '/about' 
                  ? 'bg-canvas border border-hairline-strong/20 text-ink font-semibold shadow-xs' 
                  : 'text-body hover:text-ink hover:bg-canvas-soft-2/80'
              }`}
              id="nav-about-link"
            >
              About
            </a>
            <a 
              href="/contact" 
              class={`text-sm font-medium transition-all duration-200 px-3 py-1.5 rounded-full ${
                pathname === '/contact' 
                  ? 'bg-canvas border border-hairline-strong/20 text-ink font-semibold shadow-xs' 
                  : 'text-body hover:text-ink hover:bg-canvas-soft-2/80'
              }`}
              id="nav-contact-link"
            >
              Contact
            </a>
            <Show when="signed-in">
              <a 
                href="/dashboard" 
                class={`text-sm font-medium transition-all duration-200 px-4 py-1.5 rounded-full ${
                  isDashboard 
                    ? 'bg-canvas border border-hairline-strong/20 text-ink font-semibold shadow-xs' 
                    : 'text-body hover:text-ink hover:bg-canvas-soft-2/80'
                }`}
                id="nav-dashboard-link"
              >
                Dashboard
              </a>
            </Show>
          </div>

          <Show when="signed-in">
            <div class="relative w-8 h-8 rounded-full bg-canvas-soft-2 border border-hairline hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer flex items-center justify-center shadow-xs user-avatar-placeholder" id="nav-user-button-container">
              <UserButton 
                afterSignOutUrl="/" 
                appearance={{
                  elements: {
                    userButtonAvatarBox: "w-8 h-8",
                    userButtonTrigger: "w-8 h-8 focus:outline-none"
                  }
                }}
              />
            </div>
          </Show>
          <Show when="signed-out">
            <a 
              href="/sign-in" 
              class="h-9 px-4 sm:h-10 sm:px-5 bg-primary text-on-primary hover:bg-primary/95 text-xs sm:text-sm font-semibold rounded-full tracking-wide transition-all duration-200 hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center shadow-xs"
              id="nav-login-link"
            >
              Log In
            </a>
          </Show>

          <!-- Theme Toggle Button -->
          <button 
            id="theme-toggle" 
            class="w-9 h-9 flex items-center justify-center rounded-full border border-hairline hover:border-hairline-strong hover:bg-canvas-soft-2/80 hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer shadow-xs"
            aria-label="Toggle theme"
          >
            <!-- Sun Icon (shown in dark mode) -->
            <svg id="sun-icon" class="w-4.5 h-4.5 text-ink hidden dark:block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg id="moon-icon" class="w-4.5 h-4.5 text-ink dark:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>

          <!-- Mobile Menu Button -->
          <button 
            id="mobile-menu-toggle" 
            class="md:hidden w-9 h-9 flex flex-col items-center justify-center rounded-full border border-hairline hover:border-hairline-strong hover:bg-canvas-soft-2/80 hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer shadow-xs gap-[4px] relative"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <span class="w-4 h-[2px] bg-ink rounded-full transition-all duration-300 transform origin-center" id="bar1"></span>
            <span class="w-4 h-[2px] bg-ink rounded-full transition-all duration-300 transform origin-center" id="bar2"></span>
            <span class="w-4 h-[2px] bg-ink rounded-full transition-all duration-300 transform origin-center" id="bar3"></span>
          </button>
        </nav>
        
      </div>
    </header>

    <!-- Mobile Menu Overlay (Moved outside header to prevent backdrop-filter positioning bug) -->
    <div id="mobile-menu" class="fixed inset-0 z-40 bg-canvas md:hidden flex flex-col pt-24 px-8 opacity-0 pointer-events-none -translate-y-4 transition-all duration-300 ease-in-out" style="background-color: var(--color-canvas);">
      <nav class="flex flex-col gap-6 text-lg font-medium" aria-label="Mobile Navigation">
        <a href="/" class="py-2 border-b border-hairline/50 hover:text-primary transition-colors" id="mobile-nav-home-link">Home</a>
        <a href="/about" class="py-2 border-b border-hairline/50 hover:text-primary transition-colors" id="mobile-nav-about-link">About</a>
        <a href="/contact" class="py-2 border-b border-hairline/50 hover:text-primary transition-colors" id="mobile-nav-contact-link">Contact</a>
        <Show when="signed-in">
          <a href="/dashboard" class="py-2 border-b border-hairline/50 hover:text-primary transition-colors" id="mobile-nav-dashboard-link">Dashboard</a>
          <div class="py-4 border-b border-hairline/50 flex items-center justify-between" id="mobile-nav-user-container">
            <span class="text-base text-body">Account settings</span>
            <div class="relative w-8 h-8 rounded-full bg-canvas-soft-2 border border-hairline flex items-center justify-center shadow-xs user-avatar-placeholder">
              <UserButton 
                afterSignOutUrl="/" 
                appearance={{
                  elements: {
                    userButtonAvatarBox: "w-8 h-8",
                    userButtonTrigger: "w-8 h-8 focus:outline-none"
                  }
                }}
              />
            </div>
          </div>
        </Show>
        <Show when="signed-out">
          <a href="/sign-in" class="py-3 bg-primary text-on-primary hover:bg-primary/95 text-center text-sm font-semibold rounded-full tracking-wide transition-all shadow-xs mt-4" id="mobile-nav-login-link">Log In</a>
        </Show>
      </nav>
    </div>

    <!-- Main Content Area -->
    <main class="flex-grow flex flex-col justify-start">
      <slot />
    </main>

    <!-- Sleek Minimalist Footer -->
    <footer class="w-full bg-canvas border-t border-hairline py-8" aria-label="Site Footer">
      <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mute font-mono">
        <div>
          <span>&copy; {new Date().getFullYear()} readinglistapp.com. All rights reserved.</span>
        </div>
        <div class="flex items-center gap-4 flex-wrap justify-center sm:justify-end">
          <a href="/about" class="hover:text-body transition-colors">About Us</a>
          <span>&middot;</span>
          <a href="/privacy" class="hover:text-body transition-colors">Privacy Policy</a>
          <span>&middot;</span>
          <a href="/terms" class="hover:text-body transition-colors">Terms</a>
          <span>&middot;</span>
          <a href="/contact" class="hover:text-body transition-colors">Contact Us</a>
          <span>&middot;</span>
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-body transition-colors">GitHub</a>
        </div>
      </div>
    </footer>
    
    <script>
      const toggleBtn = document.getElementById('theme-toggle');
      if (toggleBtn) {
        toggleBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      // Mobile Menu Logic with CSS Transitions
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const bar1 = document.getElementById('bar1');
      const bar2 = document.getElementById('bar2');
      const bar3 = document.getElementById('bar3');

      if (mobileMenuToggle && mobileMenu && bar1 && bar2 && bar3) {
        const toggleMenu = (open) => {
          mobileMenuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          
          if (open) {
            // Animating Hamburger to X
            bar1.classList.add('translate-y-[6px]', 'rotate-45');
            bar2.classList.add('opacity-0');
            bar3.classList.add('-translate-y-[6px]', '-rotate-45');
            
            // Animating Overlay open
            mobileMenu.classList.remove('opacity-0', 'pointer-events-none', '-translate-y-4');
            mobileMenu.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
            document.body.classList.add('overflow-hidden');
          } else {
            // Animating X back to Hamburger
            bar1.classList.remove('translate-y-[6px]', 'rotate-45');
            bar2.classList.remove('opacity-0');
            bar3.classList.remove('-translate-y-[6px]', '-rotate-45');
            
            // Animating Overlay closed
            mobileMenu.classList.add('opacity-0', 'pointer-events-none', '-translate-y-4');
            mobileMenu.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
            document.body.classList.remove('overflow-hidden');
          }
        };

        mobileMenuToggle.addEventListener('click', () => {
          const isExpanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
          toggleMenu(!isExpanded);
        });

        // Close menu when a link is clicked
        const mobileLinks = mobileMenu.querySelectorAll('a');
        mobileLinks.forEach(link => {
          link.addEventListener('click', () => {
            toggleMenu(false);
          });
        });
      }
    </script>
  </body>
</html>
